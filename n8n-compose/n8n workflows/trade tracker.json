    {
      "parameters": {
        "jsCode": "function getPreviousTradingDay(date) {\n  const day = date.getDay(); // 0 = Sunday, 1 = Monday, ..., 6 = Saturday\n  const newDate = new Date(date);\n\n  if (day === 0) {\n    // Sunday → go back to Friday\n    newDate.setDate(date.getDate() - 2);\n  } else if (day === 1) {\n    // Monday → go back to Friday\n    newDate.setDate(date.getDate() - 3);\n  } else {\n    // Any other weekday → go back one day\n    newDate.setDate(date.getDate() - 1);\n  }\n\n  return newDate.toISOString().split(\"T\")[0];\n}\n\nfunction getTodayTradingDay(date) {\n  const day = date.getDay();\n  if (day === 0 || day === 6) {\n    return null; // Not a trading day\n  }\n  return date.toISOString().split(\"T\")[0];\n}\n\n// Get dates\nconst today = new Date();\nconst todayTradingDay = getTodayTradingDay(today);\nconst previousTradingDay = getPreviousTradingDay(today);\n\n// Output\nreturn [\n  {\n    json: {\n      today_trading_day: todayTradingDay,\n      previous_trading_day: previousTradingDay\n    }\n  }\n];\n"
      },
